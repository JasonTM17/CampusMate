# CampusMate environment template (§5/§61).
# Copy to `.env` for local overrides. NEVER commit a real .env or any secret.

# ── AI provider (server-side only — the mobile app never holds AI keys) ──
# Provider adapter to activate: openai-compatible | glm (via base URL) | fake
AI_PROVIDER=fake
# OpenAI-compatible endpoint base URL (e.g. https://api.openai.com/v1 or a
# GLM-compatible gateway). Leave empty when AI_PROVIDER=fake.
AI_BASE_URL=
# Secret key for the AI provider. Keep this out of the repository.
AI_API_KEY=
# Model identifiers used by the orchestrator.
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# ── Serverpod server secrets ──
# Dev-only values live in server/config/*.yaml (regenerated by the template).
# Production must inject these via the deployment environment instead.
SERVERPOD_RUN_MODE=development

# ── Object storage (S3-compatible / MinIO dev) ──
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=campusmate-books
S3_ACCESS_KEY=campusmate-dev
# S3_SECRET_KEY belongs in your local .env only — never commit it.
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── Mobile (passed via --dart-define at build time, not this file) ──
# CAMPUSMATE_SERVER_URL=http://10.0.2.2:8080/   # Android emulator → host
